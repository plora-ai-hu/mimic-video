# cp secrets.env.example secrets.env && chmod 600 secrets.env
# secrets.env is sourced by container/train.sbatch and so100/so101_serve.sbatch and must never be committed.
export WANDB_API_KEY=
# Optional overrides of the wandb entity, project and mode (online / offline / disabled).
export WANDB_ENTITY=
export WANDB_PROJECT=
export WANDB_MODE=
# Shared secret between so100/so101_policy_server.py and so100/so101_robot_client.py, e.g. `openssl rand -hex 32`.
export MIMIC_POLICY_TOKEN=
